{
  "name": "oikres",
  "version": "2.2.0",
  "private": true,
  "description": "Oikres - student lodge and property marketplace for Awka (oikres.com)",
  "main": "server.js",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "admin:create": "node src/cli/admin.js create",
    "admin:reset": "node src/cli/admin.js reset",
    "seed": "node src/cli/seed.js",
    "seed:remove": "node src/cli/seed.js --remove",
    "backup": "node src/cli/backup.js",
    "smoke": "node scripts/smoke.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^6.9.16"
  }
}
