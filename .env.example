# Oikres configuration. The defaults below work as they are for local use:
#   npm install
#   cp .env.example .env
#   npm start
# Lines starting with # are comments. Everything marked OPTIONAL can stay as it is.

# --- Basics --------------------------------------------------------------------
# development on your computer, production on the live server
NODE_ENV=development
PORT=3000
# The public address of the site. Production must be https, e.g. https://oikres.com
BASE_URL=http://localhost:3000
# Where the database, uploads and backups live. Production: use a persistent disk.
DATA_DIR=./data

# --- Sessions ------------------------------------------------------------------
# Development: leave empty (a secret is created and saved in data/ for you).
# Production: REQUIRED, 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- First administrator -------------------------------------------------------
# LOCAL DEVELOPMENT ONLY: these example values create an admin when you first start the
# app, and the sign-in is printed in the terminal. In production the app refuses these
# example values: set your own strong ADMIN_PASSWORD (12+ characters) or run
#   npm run admin:create
ADMIN_NAME=Oikres Admin
ADMIN_EMAIL=admin@oikres.local
ADMIN_PASSWORD=oikres-local-admin

# --- Photos and videos (OPTIONAL) ---------------------------------------------
# Empty = files are stored on this server in DATA_DIR/uploads (works out of the box).
# Fill all three to store photos and videos on Cloudinary instead (https://cloudinary.com).
# ID documents always stay private on this server, never on Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (OPTIONAL locally, REQUIRED in production) --------------------------
# Empty SMTP_HOST = emails are printed in the terminal and email verification is skipped,
# so you can test everything locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Oikres <no-reply@oikres.com>
# Production without email (not recommended): set to true to allow starting without SMTP.
ALLOW_NO_EMAIL=false

# --- Support and notifications (OPTIONAL) -------------------------------------
SUPPORT_EMAIL=support@oikres.com
# Digits only with country code, no plus sign. Example: 2348012345678
# This number powers the "Chat with the admin" button. You can also set it in Admin > Site settings,
# which takes priority over this value.
SUPPORT_WHATSAPP=
# Receives an email whenever a lodge is submitted for review
ADMIN_NOTIFY_EMAIL=

# --- Advanced (OPTIONAL) -------------------------------------------------------
# Number of proxies in front of the app. Empty = 0 in development, 1 in production.
TRUST_PROXY=
# debug, info, warn or error
LOG_LEVEL=info
