<%- include('partials/top') %>
<% const extra = (f.min ? 1 : 0) + (f.max ? 1 : 0) + amenities.length; const first = user ? user.name.split(' ')[0] : ''; %>
<noscript><style>.filters{position:static!important;transform:none!important;visibility:visible!important;width:auto!important;margin-top:12px;border-radius:var(--r)!important}.filters-btn,.sheet-backdrop{display:none!important}</style></noscript>
<div class="container">
  <div class="intro">
    <p class="greet"><span data-greeting>Welcome</span><%= first ? ', ' + first : '' %></p>
    <h1>Find your next lodge</h1>
  </div>
  <form id="browse" class="browse" method="get" action="/" role="search">
    <div class="browse-top">
      <div class="searchbar">
        <%- icon('search') %>
        <input type="search" name="q" value="<%= q %>" placeholder="Search lodges, areas, junctions" aria-label="Search lodges" enterkeyhint="search" autocomplete="off" maxlength="60">
        <button class="btn btn-primary btn-sm" type="submit">Search</button>
      </div>
      <div class="quick">
        <select name="state" data-autosubmit aria-label="State">
          <option value="">Any state</option>
          <% states.forEach(function (s) { %><option value="<%= s.slug %>" <%= f.state === s.slug ? 'selected' : '' %>><%= s.name %></option><% }) %>
        </select>
        <select name="campus" data-autosubmit aria-label="Campus">
          <option value="">Any campus</option>
          <% campuses.forEach(function (c) { %><option value="<%= c.slug %>" <%= f.campus === c.slug ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
        <select name="area" data-autosubmit aria-label="Area">
          <option value="">Any area</option>
          <% areas.forEach(function (a) { %><option value="<%= a.slug %>" <%= f.area === a.slug ? 'selected' : '' %>><%= a.name %><%= showStateOnAreas ? ', ' + a.stateName : '' %></option><% }) %>
        </select>
        <select name="type" data-autosubmit aria-label="Type of place">
          <option value="">Any type</option>
          <% C.PROPERTY_TYPES.forEach(function (t) { %><option value="<%= t.value %>" <%= f.type === t.value ? 'selected' : '' %>><%= t.label %></option><% }) %>
        </select>
        <label class="chip-toggle"><input type="checkbox" name="roommate" value="1" data-autosubmit <%= f.roommate ? 'checked' : '' %>><span><%- icon('users') %>Roommate needed</span></label>
        <button type="button" class="btn btn-ghost filters-btn" data-open="filters" aria-controls="filters"><%- icon('sliders') %>Filters<% if (extra) { %><span class="count-badge"><%= extra %></span><% } %></button>
      </div>
    </div>

    <div class="sheet-backdrop" data-close="filters"></div>
    <aside class="filters" id="filters" aria-label="More filters">
      <div class="sheet-head"><h2>Filters</h2><button type="button" class="icon-btn" data-close="filters" aria-label="Close filters"><%- icon('x') %></button></div>
      <div class="field">
        <span class="label" id="rent-label">Rent per year (&#8358;)</span>
        <div class="grid-2" role="group" aria-labelledby="rent-label">
          <input type="number" inputmode="numeric" name="min" min="0" step="10000" placeholder="Min" value="<%= f.min %>" aria-label="Minimum rent">
          <input type="number" inputmode="numeric" name="max" min="0" step="10000" placeholder="Max" value="<%= f.max %>" aria-label="Maximum rent">
        </div>
      </div>
      <fieldset class="field">
        <legend class="label">Must have</legend>
        <div class="chips">
          <% C.AMENITIES.forEach(function (a) { %>
            <label class="chip-toggle"><input type="checkbox" name="amenities" value="<%= a.value %>" <%= amenities.indexOf(a.value) > -1 ? 'checked' : '' %>><span><%= a.label %></span></label>
          <% }) %>
        </div>
      </fieldset>
      <div class="sheet-foot">
        <a class="btn btn-ghost" href="/">Clear all</a>
        <button class="btn btn-primary" type="submit">Show results</button>
      </div>
    </aside>

    <section class="results" aria-live="polite">
      <div class="results-head">
        <p class="muted small count"><%= total %> lodge<%= total === 1 ? '' : 's' %><%= activeFilters ? ' match your search' : ' available' %><% if (activeFilters) { %> &middot; <a href="/">Clear filters</a><% } %></p>
        <select name="sort" data-autosubmit data-ui="compact" aria-label="Sort by">
          <option value="new" <%= sort === 'new' ? 'selected' : '' %>>Sort: Newest</option>
          <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Sort: Rent, low to high</option>
          <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Sort: Rent, high to low</option>
        </select>
      </div>
      <% if (listings.length) { %>
        <div class="grid" id="grid"><%- include('partials/cards-more') %></div>
        <% if (hasMore || prevUrl) { %>
          <nav class="pager" id="pager" aria-label="More lodges">
            <% if (prevUrl) { %><a class="btn btn-ghost" href="<%= prevUrl %>" data-prev rel="prev">Previous</a><% } %>
            <% if (hasMore) { %><a class="btn btn-ghost" href="<%= nextUrl %>" rel="next" data-load-more>Show more lodges</a><% } %>
          </nav>
        <% } %>
      <% } else { %>
        <div class="empty">
          <%- icon('search') %>
          <h2>No lodges match</h2>
          <p class="muted">Try a wider budget, another area, or remove a filter.</p>
          <a class="btn btn-primary" href="/">Clear filters</a>
        </div>
        <% if (locals.mixed) { %><div class="grid" style="margin-top:16px"><%- include('partials/cards-more') %></div><% } %>
      <% } %>
    </section>
  </form>
</div>
<%- include('partials/bottom') %>
