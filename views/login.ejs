<%- include('partials/top') %>
<div class="container">
  <div class="card auth">
    <h1>Sign in</h1>
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <input type="hidden" name="returnTo" value="<%= returnTo %>">
      <div class="field"><label class="label" for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" inputmode="email" value="<%= form.email || '' %>" required></div>
      <div class="field"><label class="label" for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required></div>
      <button class="btn btn-primary btn-block" type="submit">Sign in</button>
    </form>
    <p class="center" style="margin-top:16px"><a href="/forgot">Forgot your password?</a></p>
    <p class="center muted">New to <%= site.name %>? <a href="/register?returnTo=<%= encodeURIComponent(returnTo) %>">Create an account</a></p>
  </div>
</div>
<%- include('partials/bottom') %>
