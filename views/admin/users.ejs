<%- include('../partials/top') %>
<div class="container" style="max-width:1100px">
  <h1>Users</h1>
  <div class="tabs" role="tablist">
    <% [['all', 'All'], ['admins', 'Admins'], ['listers', 'Listers'], ['unverified', 'Unverified email'], ['suspended', 'Suspended'], ['banned', 'Banned'], ['deleted', 'Deleted']].forEach(function (t) { %><a href="?filter=<%= t[0] %>&q=<%= encodeURIComponent(q) %>" <%- filter === t[0] ? 'aria-current="page"' : '' %>><%= t[1] %></a><% }) %>
  </div>
  <form method="get" action="/admin/users" class="searchbar" style="margin-bottom:14px;max-width:560px" role="search">
    <input type="hidden" name="filter" value="<%= filter %>">
    <%- icon('search') %><input type="search" name="q" value="<%= q %>" placeholder="Search name, email or phone" aria-label="Search people" maxlength="60"><button class="btn btn-primary btn-sm" type="submit">Search</button>
  </form>
  <p class="muted small"><%= total %> account<%= total === 1 ? '' : 's' %></p>
  <div class="table-wrap"><table>
    <thead><tr><th>Person</th><th>Role</th><th>Status</th><th>Lodges</th><th>Joined</th></tr></thead>
    <tbody>
      <% users.forEach(function (u) { %>
        <tr>
          <td class="wrap"><a href="/admin/users/<%= u.uid %>"><strong><%= u.name %></strong></a><br><span class="muted small"><%= u.email %></span></td>
          <td><% if (u.isAdmin) { %><span class="tag tag-warn">Admin</span> <% } %><% if (u.roles.indexOf('lister') > -1) { %><span class="tag tag-info">Lister</span><% } else if (!u.isAdmin) { %><span class="tag">Seeker</span><% } %></td>
          <td><span class="tag <%= u.status === 'active' ? 'tag-ok' : 'tag-danger' %>"><%= u.status %></span><% if (!u.emailVerifiedAt && u.status === 'active') { %> <span class="tag tag-warn">Email not verified</span><% } %></td>
          <td><%= u.listingCount %></td><td><%= formatDate(u.createdAt) %></td>
        </tr>
      <% }) %>
      <% if (!users.length) { %><tr><td colspan="5" class="muted">Nobody here.</td></tr><% } %>
    </tbody>
  </table></div>
  <% if (pages > 1) { %><nav class="pager"><% if (page > 1) { %><a class="btn btn-ghost btn-sm" href="?filter=<%= filter %>&q=<%= encodeURIComponent(q) %>&page=<%= page - 1 %>">Previous</a><% } %><% if (page < pages) { %><a class="btn btn-ghost btn-sm" href="?filter=<%= filter %>&q=<%= encodeURIComponent(q) %>&page=<%= page + 1 %>">Next</a><% } %></nav><% } %>
</div>
<%- include('../partials/bottom') %>
